# ============================================================
# Detector de Obfuscação: configuração (preencher pela firma)
# Copiar para .env (servidor próprio) ou definir como variáveis
# de ambiente no Vercel. Nunca gravar a chave no repositório.
# ============================================================

# --- 1. Chave da API (OBRIGATÓRIO) ------------------------------
# Chave da API do Claude da firma, criada na consola da Anthropic.
ANTHROPIC_API_KEY=
# Só se a firma usar um gateway compatível com a API de mensagens da Anthropic.
# (Amazon Bedrock e Google Vertex precisam de adaptação: não incluída.)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Modelos: confirmar com a TI os modelos contratados e o seu custo.
# DETECTOR_MODEL=claude-sonnet-5-5
# DETECTOR_MODEL_DEEP=claude-opus-5-5
# DEEP_ENABLED=1                 # 0 desliga a opção «análise mais profunda»

# --- 2. Acesso / login da firma (DECIDIR) -----------------------
# none  : sem controlo (só desenvolvimento e demonstração)
# code  : códigos de acesso; um por pessoa dá quotas individuais
# proxy : o servidor está atrás do SSO da firma, que envia o e-mail num cabeçalho
AUTH_MODE=code
# ACCESS_CODES=codigo1,codigo2,codigo3
# TRAINER_CODES=codigo-formador   # vê o gabarito dos exemplos
# modo proxy:
# PROXY_USER_HEADER=x-forwarded-email
# ALLOWED_EMAIL_DOMAINS=firma.pt
# TRAINER_USERS=formador1@firma.pt,formador2@firma.pt

# --- 3. Limites (DECIDIR) --------------------------------------
# MAX_INPUT_BYTES=50000          # tamanho máximo do texto (principal + apoio), em bytes
# MIN_CHARS=120                  # tamanho mínimo do texto principal
# MAX_OUTPUT_TOKENS=8000         # tamanho máximo da resposta
# PER_USER_DAILY=20              # análises por utilizador (ou código) por dia; 0 = sem limite
# GLOBAL_DAILY=300               # análises por dia, no total; 0 = sem limite
# GLOBAL_DAILY_TOKENS=0          # tokens por dia, no total; 0 = sem limite
# MAX_CONCURRENT=3               # análises em simultâneo
# REQUEST_TIMEOUT_MS=170000
# Os contadores estão em memória: servem a um servidor único. O limite que
# conta é o limite de gasto definido na consola da Anthropic.

# --- 4. Informação ao utilizador e registos --------------------
# PRIVACY_NOTICE=Texto a mostrar no ecrã sobre o tratamento do documento.
# LOG_USERS=1                    # 0 deixa de registar o identificador (hash) do utilizador

# --- 5. Alojamento (DECIDIR) -----------------------------------
# Servidor próprio:  npm start   ou   docker build -t detector . && docker run --env-file .env -p 3000:3000 detector
# Vercel:            importar o repositório e definir estas variáveis no projecto
# PORT=3000
